{
    auto_https off
}

# If you have a domain pointed at the Oracle VM, replace :80 with your domain.
# For testing with just the public IP, use :80.
:80 {
    # Hermes state API
    handle_path /hermes/* {
        reverse_proxy {$HERMES_HOST}:{$HERMES_PORT} {
            header_up Host {host}
            header_up X-Real-IP {remote}
        }
    }

    # Optional: health endpoint for the VM itself
    respond /health "ok" 200
}

# When you add a domain, use this block instead:
# hermes.neuralquant.co {
#     handle_path /hermes/* {
#         reverse_proxy {$HERMES_HOST}:{$HERMES_PORT}
#     }
# }
