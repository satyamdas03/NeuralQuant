# NeuralQuant — Oracle Cloud Free Tier env template
# Copy to /opt/neuralquant/infra/oracle-cloud/.env and fill values.
# NO real values should be committed.

# === Hermes crypto paper-trading agent ===
HERMES_TRADING_MODE=paper
HERMES_API_PORT=6900
ANTHROPIC_API_KEY=
HERMES_API_SECRET=                    # shared secret forwarded as X-Hermes-Secret
HERMES_MODEL=                         # optional model override
HERMES_BIN=                           # optional path to hermes CLI for reflection
RESEED_STRATEGY=false                 # one-time strategy reset; set true then remove

# Exchange keys (paper mode usually still needs read-only price data keys)
# KRAKEN_API_KEY=
# KRAKEN_PRIVATE_KEY=

# === NeuralQuant core services ===
ENVIRONMENT=production
RENDER=false
LOG_LEVEL=INFO
FRONTEND_URL=https://neuralquant.ai
NEXT_PUBLIC_SITE_URL=https://neuralquant.ai

# === LLM ===
# ANTHROPIC_API_KEY is already listed under Hermes; shared across services
USE_BEDROCK=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
BEDROCK_RUNTIME_REGION=
NQ_QUERY_MODEL=
NQ_FAST_MODEL=

# === Market data ===
FMP_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# === Persistence (managed Supabase) ===
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_DB_URL=

# === Payments (only if trader/quantastra need Stripe introspection) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Voice (QuantAstra / Veronica) ===
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
VERONICA_VOICE_ID=cgSgspJ2msm6clMCkdW9

# === Trading daemon (nq-trader) ===
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
TRADE_ENABLED=true
DRY_RUN=true
DAILY_LOSS_LIMIT=100.0
MAX_BET_DEFAULT=5000.0
MAX_POSITIONS_DEFAULT=10
TRADE_DAEMON_MARKET=US
TRADE_DAEMON_STRATEGY=value_play
TRADE_DAEMON_BANKROLL=10000.0
TRADE_DAEMON_SCAN_INTERVAL_MINUTES=15
TRADE_DAEMON_TOP_N=10
TRADE_DAEMON_MAX_SIGNALS_PER_DAY=20

# === Cron invoker ===
CRON_SECRET=                          # auth for POST /cron endpoints on Render nq-api
CRON_BASE_URL=https://neuralquant.onrender.com

# === Networking ===
# Caddy container uses these to reach Hermes. Usually no change needed.
HERMES_HOST=hermes
