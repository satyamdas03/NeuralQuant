# NeuralQuant — Oracle Cloud Free Tier env template
# Copy to .env and fill. No real values here.

# === Hermes ===
HERMES_TRADING_MODE=paper
HERMES_API_PORT=6900
ANTHROPIC_API_KEY=

# Exchange keys (paper mode usually still needs API keys for price data)
# KRAKEN_API_KEY=
# KRAKEN_PRIVATE_KEY=

# === Networking ===
# Public domain pointing at the Oracle VM, or leave blank to use public IP
HERMES_HOST=hermes
