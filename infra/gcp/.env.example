# Hermes trading agent environment — copy to /opt/hermes/.env on the GCP VM.
HERMES_TRADING_MODE=paper
HERMES_API_PORT=8000

# Long random string; must match Render nq-api HERMES_API_SECRET.
HERMES_API_SECRET=CHANGE_ME

# For --hermes (Claude) reflection. Optional — fallback reflection works without.
ANTHROPIC_API_KEY=

# Optional Kraken API keys (public data works without them).
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
